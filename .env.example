# =============================================================================
# Code Review Agent — .env テンプレート
# このファイルを .env にコピーして必要な値を入力してください。
# .env はリポジトリにコミットしないこと。
# =============================================================================

# ─── 必須 ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...          # provider_type=openai 使用時。互換プロバイダーではダミー値でも可。provider_type=ollama では不要
GITHUB_TOKEN=ghp_...           # GitHub personal access token（評価パイプライン・GitHub MCP 接続に必須）

# ─── LLM プロバイダー設定（1 つのみ有効にする）──────────────────────────────────
# CODE_REVIEW_PROVIDER_TYPE は openai（デフォルト）/ ollama を選択する（Issue #214、
# docs/model-provider-factory-spec.md 参照）。リクエスト単位のオーバーライドは不可。

# --- OpenAI（デフォルト、設定不要） ---
CODE_REVIEW_MODEL_ID=gpt-4o
# CODE_REVIEW_PROVIDER_TYPE=openai   # デフォルト。明示不要

# --- Ollama（ローカル・ネイティブ SDK 経由）を使う場合 ---
# CODE_REVIEW_PROVIDER_TYPE=ollama
# CODE_REVIEW_LLM_BASE_URL=http://localhost:11434   # /v1 を付けない
# CODE_REVIEW_MODEL_ID=gemma4:e4b
# OPENAI_API_KEY は provider_type=ollama では使用されない

# --- LM Studio（ローカル、OpenAI 互換のまま）を使う場合 ---
# CODE_REVIEW_PROVIDER_TYPE=openai
# CODE_REVIEW_LLM_BASE_URL=http://localhost:1234/v1
# CODE_REVIEW_MODEL_ID=lmstudio-community/gemma-3-4b-it-GGUF
# OPENAI_API_KEY=lm-studio

# --- OpenRouter（OpenAI 互換のまま）を使う場合 ---
# CODE_REVIEW_PROVIDER_TYPE=openai
# CODE_REVIEW_LLM_BASE_URL=https://openrouter.ai/api/v1
# CODE_REVIEW_MODEL_ID=openai/gpt-4o
# OPENAI_API_KEY=sk-or-...

# ─── ローカルモデルの暴走対策（任意）───────────────────────────────────────────
# ローカルモデル（Ollama 等）が単一ターンで生成ループに陥り、長時間停止しないようにする
# 安全弁。max_tokens 到達時は MaxTokensReachedException で当該 reviewer が即座に中断され、
# ReviewError として隔離されるため他の reviewer には影響しないが、低すぎる値は正常な
# 長いレビューまで 0 findings 化させる副作用がある。以下の値は、正常なターンでは到達せず
# 暴走ターンのみを 1.5〜3 分程度で確実に打ち切ることを実測で確認済み。
CODE_REVIEW_MAX_TOKENS=4000

# frequency_penalty は繰り返し抑制（OpenAI 準拠、-2.0〜2.0）。
# 実測（ornith:latest / gpt-oss:latest, bitwarden/clients#21439）:
#   0/0.4/0.6/0.7/0.8/1.0 のいずれも「JSON 出力を壊さず完了する」水準には未到達
#   （繰り返し自体は解消せず MaxTokensReachedException、または StructuredOutputException
#   を誘発）。値とモデル・タスクの相性に強く依存するため、検証済みのデフォルトは無い。
# 試行錯誤で調整する場合の出発点として使うこと。
# CODE_REVIEW_FREQUENCY_PENALTY=0.4

# ─── PR Diff 同梱設定（任意）────────────────────────────────────────────────────
# PRInfoResult に patch を同梱する際の閾値。超過時は patch=None にフォールバックし、
# レビュアーが GitHub MCP でフェッチする。
# CODE_REVIEW_PATCH_TOTAL_CHAR_LIMIT=30000
# CODE_REVIEW_PATCH_MAX_FILES=30

# ─── サービス設定（任意）────────────────────────────────────────────────────────
CODE_REVIEW_HOST=0.0.0.0
CODE_REVIEW_PORT=8000
CODE_REVIEW_LOG_LEVEL=info

# ─── AgentCard URL（モノリス構成では設定不要）───────────────────────────────────
# CODE_REVIEW_AGENT_BASE_URL=http://localhost:8000

# ─── GitHub MCP エンドポイント（任意）───────────────────────────────────────────
# GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/read-only

# ─── 評価パイプライン完了通知（任意）────────────────────────────────────────────
# 設定すると run_agent_evaluation.py 完了時に Discord へ通知が送信される。
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

