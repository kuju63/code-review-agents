{
  "name": "code-review-agent-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.12.0",
    "ai-sdk-ollama": "^3.8.8",
    "openai": "^7.4.0"
  }
}
