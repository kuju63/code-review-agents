{
  "name": "code-review-agent-ts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm exec tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.0.0",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.12.0",
    "ai-sdk-ollama": "^3.8.8",
    "openai": "^7.4.0",
    "zod": "^4.1.12"
  }
}
