{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["serena-agent"],
      "allowedVersions": "/^[0-9]+(?:\\.[0-9]+)*$/",
      "groupName": "serena-agent"
    },
    {
      "matchPackageNames": ["ai-sdk-ollama"],
      "allowedVersions": "/^3\\.8\\./"
    },
    {
      "matchDatasources": ["docker"],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^opencode\\.jsonc$/"],
      "matchStrings": [
        "renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s\"]+)\\s*\"serena-agent==(?<currentValue>[0-9.]+)\""
      ],
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": [
        "\"serena-agent==(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "serena-agent",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "semanticCommits": "enabled"
}
